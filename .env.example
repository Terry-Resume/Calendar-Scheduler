# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Database (Supabase). SERVER-SIDE ONLY: never prefix these with NEXT_PUBLIC_. ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Admin access: comma-separated Clerk user ids. There is no built-in default. ──
ADMIN_USER_IDS=

# ── Discord meeting alerts (cron) ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
# Required for /api/cron/*; the endpoint answers 503 without it. Use a long random string.
CRON_SECRET=

# ── Google Calendar sync (optional) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000   # redirect URI: <this>/api/auth/google/callback
# Signs the OAuth state; defaults to CLERK_SECRET_KEY if unset.
OAUTH_STATE_SECRET=
